---
import { env } from "cloudflare:workers";
import { getData } from "../lib/iptv";
import Layout from "../layouts/Layout.astro";

const { channel } = Astro.params;
const initial = Astro.url.searchParams.get("initial") === "true";

const src = await env.DB.prepare("SELECT url FROM channels WHERE id = ?")
	.bind(channel)
	.first();

const nav = await env.DB.prepare(
	`
	SELECT
		COALESCE(
			(SELECT MAX(id) FROM channels WHERE id < ?),
			(SELECT MAX(id) FROM channels)
		) AS prevId,
		COALESCE(
			(SELECT MIN(id) FROM channels WHERE id > ?),
			(SELECT MIN(id) FROM channels)
		) AS nextId
`,
)
	.bind(channel, channel)
	.first();

const data = new Map((await getData()).map((c) => [c.id, c]));
const channelName = data.get(channel as string)?.name;
---

<Layout title={`${channelName} - Orbit`}>
	<main
		class="flex min-h-dvh items-center justify-center bg-black bg-cover bg-center"
	>
		<img
			id="smpte"
			src="https://t3.ftcdn.net/jpg/05/39/64/56/360_F_539645678_UGE3wFAgMELL8kdqp72FYd7J46df43Sj.jpg"
			class="hidden h-dvh"
		/>

		<video
			id="hls-video"
			data-src={src?.url}
			class="h-dvh"
			autoplay
			playsinline
		>
		</video>

		<div
			id="osd"
			class="pointer-events-none fixed inset-0 z-10 flex animate-[disappear_7s_step-end_forwards] flex-col justify-end gap-2 p-10"
		>
			<div class="rounded-md bg-black/80 px-6 py-3 font-mono text-white">
				<p id="osd-channelName" class="text-2xl font-bold">
					{channelName}
				</p>
				<div id="osd-schedule">
					<p>Now:</p>
					<p>Next:</p>
				</div>
			</div>

			{
				initial && (
					<p
						id="osd-toast-info"
						class="rounded-md bg-green-500 px-6 py-1 font-mono font-bold text-white"
					>
						TIP: Use your remote control or keyboard arrow keys to navigate
						channels.
					</p>
				)
			}

			<p
				id="osd-toast-error"
				class="hidden rounded-md bg-red-700 px-6 py-1 font-mono font-bold text-white"
			>
			</p>
		</div>

		<div class="hidden">
			<button id="prev-btn" data-href={`/${nav?.prevId}`}></button>
			<button id="next-btn" data-href={`/${nav?.nextId}`}></button>
		</div>
	</main>
</Layout>

<style>
	@keyframes disappear {
		0%,
		99% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
</style>

<script>
	import { initPlayer } from "../lib/hls-player";

	const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
	const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;

	prevBtn?.addEventListener("click", (e) => {
		const href = (e.currentTarget as HTMLElement).dataset.href;
		if (href) location.replace(href);
	});
	nextBtn?.addEventListener("click", (e) => {
		const href = (e.currentTarget as HTMLElement).dataset.href;
		if (href) location.replace(href);
	});

	document.addEventListener("keydown", (e) => {
		switch (e.key) {
			case "ArrowLeft":
				prevBtn?.click();
				break;
			case "ArrowRight":
				nextBtn?.click();
				break;
		}
	});

	initPlayer();
</script>
